{
  "name": "freshrelay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "FreshRelay — surplus food rescue relay between food providers and recipient organizations.",
  "engines": {
    "node": ">=22.5.0"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --workspace server run dev",
    "dev:client": "npm --workspace client run dev",
    "seed": "npm --workspace server run seed",
    "test": "npm --workspace server run test && npm --workspace client run test",
    "test:server": "npm --workspace server run test",
    "test:client": "npm --workspace client run test",
    "typecheck": "npm --workspace server run typecheck && npm --workspace client run typecheck",
    "build": "npm --workspace server run build && npm --workspace client run build",
    "start": "npm --workspace server run start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
