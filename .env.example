# FreshRelay environment variables — every value below is optional in local development.
# Copy to `.env` (or export in your shell) and change what you need:
#   cp .env.example .env
#
# The server reads these via server/src/config.ts. Defaults are shown as comments.

# --- runtime -----------------------------------------------------------------
# NODE_ENV=development                # development | production | test
# PORT=3001                           # API port
# HOST=0.0.0.0                        # bind address (0.0.0.0 so the preview proxy can reach it)
# LOG_LEVEL=info                      # fastify/pino level; "silent" disables logs

# --- database ----------------------------------------------------------------
# DATABASE_PATH=data/freshrelay.db    # relative to server/ ; use ":memory:" for a throwaway DB

# --- security ----------------------------------------------------------------
# APP_SECRET=change-me-in-production  # used to encrypt pickup codes and pepper their hashes.
#                                     # The built-in default is for LOCAL DEMO ONLY; production
#                                     # refuses to boot with it.
# SESSION_COOKIE_NAME=fr_session
# SESSION_TTL_HOURS=720               # 30 days
# COOKIE_SECURE=false                 # set true behind HTTPS in production

# --- product tunables --------------------------------------------------------
# MEALS_KG_PER_MEAL=0.4               # meals = rescued kg / MEALS_KG_PER_MEAL (labelled as an estimate)
# SEARCH_DEFAULT_RADIUS_KM=5
# SEARCH_MAX_RADIUS_KM=50
# MAX_VERIFY_ATTEMPTS=5               # wrong pickup codes before the reservation is locked
# SWEEP_INTERVAL_MS=60000             # background status sweep interval

# --- demo data ---------------------------------------------------------------
# DEMO_PASSWORD=Password123!          # password used for every seeded demo account

# --- client (Vite, read at dev-server start) ---------------------------------
# CLIENT_PORT=5173
# API_PORT=3001                       # where Vite proxies /api to
# API_TARGET=http://127.0.0.1:3001    # full override of the proxy target
